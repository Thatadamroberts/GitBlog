---
import '../styles/global.css';
import config from '../../site.config';

interface Props { title?: string; description?: string; image?: string }
const { title, description = config.bio, image } = Astro.props;
const pageTitle = title ? `${title} · ${config.title}` : config.title;
const home = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={image} />}
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={home}>{config.title}</a>
      <a class="gh" href={`https://github.com/${config.username}`}>@{config.username}</a>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      Built from public repositories on GitHub tagged <code>{config.topic}</code>.
    </footer>
  </body>
</html>
